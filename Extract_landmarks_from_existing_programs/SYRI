# ---------------------------------------------------------------------------
# function to count SVs in the .csv files, assumes all csv files in the same folder and named as speciesA_svs_speciesB.csv
# ---------------------------------------------------------------------------

count_pairwise_csvs <- function(dir_path,
                                file_glob = "*_svs_*.csv",
                                pattern   = "^(.+?)-(.+?)_(?:svs|inversions).*\\.csv$") {
  
  files <- list.files(dir_path, pattern = utils::glob2rx(file_glob), full.names = TRUE)
  
  purrr::map_dfr(files, function(f) {
    fname <- basename(f)
    m <- stringr::str_match(fname, pattern)
    if (is.na(m[1, 1])) {
      warning("Filename didn't match expected pattern, skipping: ", fname)
      return(NULL)
    }
    n_rows <- nrow(readr::read_csv(f, show_col_types = FALSE))
    tibble::tibble(
      species_a  = m[1, 2],
      species_b  = m[1, 3],
      n_variants = n_rows,
      file       = fname
    )
  })
}

# ---------------------------------------------------------------------------
# function to convert long format into NXN matrix
# ---------------------------------------------------------------------------

build_dist_matrix <- function(long_df, species_a = "species_a", species_b = "species_b", value = "n_variants") {
  sp <- sort(unique(c(long_df[[species_a]], long_df[[species_b]])))
  n  <- length(sp)
  m  <- matrix(0, n, n, dimnames = list(sp, sp))
  
  for (i in seq_len(nrow(long_df))) {
    a <- long_df[[species_a]][i]
    b <- long_df[[species_b]][i]
    v <- long_df[[value]][i]
    m[a, b] <- v
    m[b, a] <- v
  }
  m
}

# ---------------------------------------------------------------------------
# function to run MDS and calculate how much variance is explained by an axis, change k value if more than two axes is of interest
# ---------------------------------------------------------------------------
run_mds <- function(dist_matrix, k = 2) {
  fit <- stats::cmdscale(as.dist(dist_matrix), k = k, eig = TRUE)
  coords <- as.data.frame(fit$points)
  colnames(coords) <- paste0("MDS", seq_len(k))
  coords <- tibble::rownames_to_column(coords, "species")
  
  # % variance explained by each axis (only meaningful for non-negative eigenvalues)
  var_explained <- fit$eig / sum(abs(fit$eig)) * 100
  attr(coords, "var_explained") <- var_explained[seq_len(k)]
  coords
}

# ---------------------------------------------------------------------------
# functions to plot results from MDS, two axes at a time 
# ---------------------------------------------------------------------------
plot_mds <- function(mds_df, title = "MDS") {
  ve <- attr(mds_df, "var_explained")
  xlab <- if (!is.null(ve)) sprintf("MDS1 (%.1f%%)", ve[1]) else "MDS1"
  ylab <- if (!is.null(ve)) sprintf("MDS2 (%.1f%%)", ve[2]) else "MDS2"
  
  ggplot(mds_df, aes(MDS1, MDS2, label = species)) +
    geom_point(size = 3) +
    ggrepel::geom_text_repel(seed = 1) +
    labs(title = title, x = xlab, y = ylab) +
    theme_minimal()
}

