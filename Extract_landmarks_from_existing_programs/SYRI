# ---------------------------------------------------------------------------
# Function to read SYRI's vcf files and parse it into tiny tibble
# ---------------------------------------------------------------------------


read_syri_vcf <- function(vcf_path) {
  
  # readr's `comment` only strips lines starting with "##", so the "#CHROM ..." header line is kept and used as the column names.
  df <- read_tsv(
    vcf_path,
    comment   = "##",
    col_types = cols(.default = "c"),
    progress  = FALSE
  )
  names(df)[1] <- "CHROM"
  
  # SVTYPE from the ALT field, e.g. "<TRANS>" -> "TRANS"
  df$SVTYPE <- str_remove_all(df$ALT, "[<>]")
  
  # Parse the INFO column (semicolon-separated key=value pairs) into columns
  info_keys <- c("END", "ChrB", "StartB", "EndB", "Parent", "VarType", "DupType")
  
  parse_info <- function(info_string) {
    pairs <- str_split(info_string, ";")[[1]]
    kv <- str_split_fixed(pairs, "=", 2)
    vals <- setNames(as.list(rep(NA_character_, length(info_keys))), info_keys)
    for (i in seq_len(nrow(kv))) {
      key <- kv[i, 1]
      if (key %in% info_keys) vals[[key]] <- kv[i, 2]
    }
    as_tibble(vals)
  }
  
  info_df <- map_dfr(df$INFO, parse_info)
  df <- bind_cols(df %>% select(-INFO), info_df)
  
  # Numeric coercion; "." (missing in SyRI) becomes NA
  to_num <- function(x) suppressWarnings(as.numeric(na_if(x, ".")))
  
  df <- df %>%
    mutate(
      POS    = to_num(POS),
      END    = to_num(END),
      StartB = to_num(StartB),
      EndB   = to_num(EndB)
    )
  
  df
}

# ---------------------------------------------------------------------------
# function to filter out non SVs and retain SVs that are atleast 500 bp long (either the reference or the query), so any SV that involves atleast 500 bp gets retained. This cutoff can be modified based on the user's question
# ---------------------------------------------------------------------------


extract_syri_svs <- function(df, min_size = 500) {
  df %>%
    filter(VarType %in% c("SR", "ShV")) %>%
    filter(SVTYPE != "HDR") %>%
    filter(SVTYPE != "SYN") %>%
    filter(SVTYPE != "SNP") %>%
    mutate(
      ref_len   = END - POS + 1,
      query_len = EndB - StartB + 1,
      SVLEN     = pmax(ref_len, query_len, na.rm = TRUE)
    ) %>%
    filter(SVLEN >= min_size) %>%
    select(-REF, -ALT, -FILTER, -QUAL) %>%
    relocate(CHROM, POS, END, ID, SVTYPE, ChrB, StartB, EndB, SVLEN, DupType)
}

# ---------------------------------------------------------------------------
# Function to extract any particular type of SVs of interest, here we were interested in extracting inversions 
# ---------------------------------------------------------------------------


extract_inversions <- function(df, min_size = 500) {
  inv_types <- c("INV", "INVTR", "INVDP")
  
  df %>%
    filter(SVTYPE %in% inv_types) %>%
    mutate(
      ref_len   = END - POS + 1,
      query_len = EndB - StartB + 1,
      SVLEN     = pmax(ref_len, query_len, na.rm = TRUE)
    ) %>%
    filter(SVLEN >= min_size) %>%
    select(-REF, -ALT, -FILTER, -QUAL) %>%
    relocate(CHROM, POS, END, ID, SVTYPE, ChrB, StartB, EndB, SVLEN, DupType)
}


