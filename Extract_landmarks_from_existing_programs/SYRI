  geom_point() +
  geom_smooth(method = "lm", se = T) +
  labs(
    x = "Disparity PC1",
    y = "Disparity Inversion MDS",
    title = "Spearman correlation",
    subtitle = paste0(
      "ρ = ", round(cor_test$estimate, 3),
      ", p = ", format.pval(cor_test$p.value, digits = 3)
    )
  ) +
  theme_classic()


