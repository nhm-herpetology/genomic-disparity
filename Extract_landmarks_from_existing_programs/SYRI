# Rename columns
colnames(combined) <- c(
  "sp1_vs_sp2",
  "PC1",
  "InvAx1"
)

#check combined file with new names and values
combined

cor_test <- cor.test(combined$PC1, combined$InvAx1, method = "spearman")

# plot the results from this test - UCE PC1 versus inversions
