# Combine PC1 and inversion results tables (repeat all the below steps seperately for all SVs)

combined <- merge(
  disparity_PC1[, c("sp1_vs_sp2", "value")],
  disparity_invaxis1[, c("sp1_vs_sp2", "value")],
  by = "sp1_vs_sp2",
  suffixes = c("_1", "_2")
)

#check combined file and values
